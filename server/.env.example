# ---------- Server ----------
PORT=4040
NODE_ENV=production
# Comma-separated list of allowed frontend origins
CLIENT_URL=https://your-client.example.com

# ---------- Database ----------
DATABASE_URL=
# Direct (non-pooled) Neon connection for Prisma migrations
DIRECT_URL=

# ---------- Auth (better-auth) ----------
# Public URL of the CLIENT (it proxies /api/auth to this server)
BETTER_AUTH_URL=https://your-client.example.com
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- AI / LLM ----------
OPENAI_API_KEY=


# ---------- Vector DB (Pinecone) ----------
PINECONE_API_KEY=
PINECONE_INDEX=

# ---------- Memory (Mem0) ----------
MEM0_API_KEY=

# ---------- Web search / scraping ----------
TAVILY_API_KEY=
FIRECRAWL_API_KEY=


# ---------- File uploads (Cloudinary) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Trigger.dev ----------
# Dashboard -> API keys -> Development secret key (tr_dev_ locally, tr_prod_ in production)
TRIGGER_SECRET_KEY=
