# Copy to .env.local for local development, and set the same keys in your
# hosting provider (e.g. Vercel → Project → Settings → Environment Variables).

# Express API (server/). Used by the /api rewrites and server-side fetches.
# REQUIRED for production builds: the build fails if it is missing.
API_URL=http://localhost:4040

# Public origin of this Next.js app. Used for canonical URLs, Open Graph
# images and robots/sitemap. Must match CLIENT_URL on the server.
NEXT_PUBLIC_APP_URL=http://localhost:3000
